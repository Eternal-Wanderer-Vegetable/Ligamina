{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligamina.dev/contracts/lab/inventory/v1/capability-inventory.schema.json",
  "title": "Ligamina plugin capability inventory v1",
  "description": "A source-bound, single-plugin inventory. Runtime and static records are separate documents and must never be merged into one observation.",
  "type": "object",
  "required": ["schema_version", "ecosystem", "plugin", "source", "capabilities", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "ecosystem": { "enum": ["koishi", "nonebot", "astrbot"] },
    "plugin": {
      "type": "object",
      "required": ["package"],
      "properties": {
        "registry_entry_id": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "maxLength": 128 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "collector", "confidence", "evidence"],
      "properties": {
        "kind": { "enum": ["runtime", "static"] },
        "collector": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confidence": { "enum": ["observed", "heuristic"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["commands", "handlers", "services", "schedulers", "configuration"],
      "properties": {
        "commands": { "$ref": "#/$defs/collection" },
        "handlers": { "$ref": "#/$defs/collection" },
        "services": { "$ref": "#/$defs/collection" },
        "schedulers": { "$ref": "#/$defs/collection" },
        "configuration": { "$ref": "#/$defs/collection" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "line": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": { "enum": ["observed", "unavailable"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "unavailable" } } }, "then": { "required": ["reason"] } },
        { "if": { "properties": { "status": { "const": "observed" } } }, "then": { "not": { "required": ["reason"] } } }
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["kind", "name", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "attributes": { "type": "object" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
