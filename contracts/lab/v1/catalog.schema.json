{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligamina.dev/contracts/lab/v1/catalog.schema.json",
  "title": "Ligamina lab catalog reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "source_snapshot_sha256", "fetched_at_utc", "entry_count", "official_maintained_count", "ecosystems"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "fetched_at_utc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$" },
    "entry_count": { "type": "integer", "minimum": 0 },
    "official_maintained_count": { "type": "integer", "minimum": 0 },
    "ecosystems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "filter_policy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
