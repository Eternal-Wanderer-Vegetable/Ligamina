{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligamina.local/contracts/lab/automation/p7-nonebot-context-profiles/v1.schema.json",
  "title": "P7 NoneBot Synthetic Test Context Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "profile_id", "execution_scope", "authority_scope", "event_envelope_role_claims", "source_report", "synthetic_actor_id", "synthetic_superuser_id", "bot_account_id", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "p7_nonebot_synthetic_context_profiles"},
    "profile_id": {"const": "p7-nonebot-source-bound-context-v1"},
    "execution_scope": {"const": "linux_worker_only_network_disabled"},
    "authority_scope": {"const": "synthetic_test_actor_only"},
    "event_envelope_role_claims": {"const": false},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "outputs/acceptance/p7-p704-no-operation-source-diagnostic-20261111.json"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "synthetic_actor_id": {"$ref": "#/$defs/onebotId"},
    "synthetic_superuser_id": {"$ref": "#/$defs/onebotId"},
    "bot_account_id": {"$ref": "#/$defs/onebotId"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "onebotId": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_kind", "mention_bot", "authorization"],
      "properties": {
        "conversation_kind": {"enum": ["group", "private"]},
        "mention_bot": {"type": "boolean"},
        "authorization": {"enum": ["none", "superuser"]}
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "context"],
      "properties": {
        "command_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "conversation_kind": {"enum": ["group", "private"]},
            "mention_bot": {"type": "boolean"},
            "authorization": {"enum": ["none", "superuser"]}
          }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "lines"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "lines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_entry_id", "package", "version", "artifact_sha256", "command_ids", "default_context", "command_overrides", "source_evidence"],
      "properties": {
        "registry_entry_id": {"type": "string", "pattern": "^nb-[0-9a-f]{24}$"},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/hash"},
        "command_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
        "default_context": {"$ref": "#/$defs/context"},
        "command_overrides": {"type": "array", "items": {"$ref": "#/$defs/override"}},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceEvidence"}}
      }
    }
  }
}
