{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liganima.invalid/contracts/lab/automation/v2/behavior-suite.schema.json",
  "title": "Phase four executable behavior suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "catalog_snapshot_id", "source_suite", "entries", "capability_probes"],
  "properties": {
    "schema_version": {"const": 2},
    "suite_id": {"enum": ["phase4-entry-behavior-v2", "phase4-linux-behavior-p402-v2", "phase4-linux-behavior-p402-v2r3"]},
    "catalog_snapshot_id": {"const": "p2-41649744e057d61031d5"},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "source_suite": {
      "type": "object",
      "required": ["suite_id", "path", "sha256"],
      "properties": {
        "suite_id": {"const": "phase3-entry-behavior-v1"},
        "path": {"const": "contracts/lab/automation/v1/fixtures/behavior-suite.phase3-v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "entries": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/entry"}},
    "capability_probes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/capabilityProbe"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object",
      "required": ["status", "profile_id", "dependency_lock_sha256", "artifact_sha256"],
      "properties": {
        "status": {"enum": ["eligible_not_run", "static_skipped"]},
        "profile_id": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "reason_code": {"type": "string"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event_id", "timestamp", "account_id", "actor_id", "conversation", "message"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "account_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "conversation": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {"kind": {"enum": ["group", "private"]}, "id": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "message": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "properties": {"type": {"const": "text"}, "text": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "extensions": {"type": "object"}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["path", "operator", "value"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "contains", "not_contains", "length_equals"]},
        "value": {}
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": ["source_member", "source_symbol", "source_artifact_sha256", "rationale", "review_status", "assertions"],
      "properties": {
        "source_member": {"type": "string", "minLength": 1},
        "source_symbol": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "rationale": {"type": "string", "minLength": 16},
        "review_status": {"const": "reviewed"},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": ["status", "v1_case_id", "v1_input", "v1_assertions", "v1_oracle"],
      "properties": {
        "status": {"enum": ["executable", "blocked"]},
        "reason_code": {"type": "string"},
        "v1_case_id": {"type": "string", "minLength": 1},
        "v1_input": {"type": "string", "minLength": 1},
        "v1_assertions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "v1_oracle": {"type": "object"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "class", "migration", "adapter", "setup", "stimulus", "determinism", "observation", "oracle"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["positive", "negative", "isolation"]},
        "migration": {"$ref": "#/$defs/migration"},
        "adapter": {"type": ["object", "null"]},
        "setup": {"type": ["object", "null"]},
        "stimulus": {"type": ["object", "null"]},
        "determinism": {"type": ["object", "null"]},
        "observation": {"type": ["object", "null"]},
        "oracle": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"migration": {"properties": {"status": {"const": "executable"}}}}, "required": ["migration"]},
          "then": {
            "properties": {
              "adapter": {
                "type": "object",
                "required": ["id", "native_dispatch", "federated_dispatch"],
                "properties": {
                  "id": {"enum": ["nonebot.onebot.v11", "koishi.onebot.v11"]},
                  "native_dispatch": {"type": "string", "minLength": 1},
                  "federated_dispatch": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              "setup": {"type": "object", "required": ["plugin_config", "user_authority", "storage"], "properties": {"plugin_config": {"type": "object"}, "user_authority": {"type": "object"}, "storage": {"type": "object"}}, "additionalProperties": false},
              "stimulus": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}}, "additionalProperties": false},
              "determinism": {"type": "object", "required": ["clock", "random_seed", "settle_timeout_ms", "scheduler_drain"], "properties": {"clock": {"type": "string", "format": "date-time"}, "random_seed": {"type": "integer"}, "settle_timeout_ms": {"type": "integer", "minimum": 1}, "scheduler_drain": {"type": "string", "minLength": 1}}, "additionalProperties": false},
              "observation": {"type": "object", "required": ["projection", "source"], "properties": {"projection": {"enum": ["message_operations", "service_storage_clock"]}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": false},
              "oracle": {"$ref": "#/$defs/oracle"}
            }
          },
          "else": {
            "properties": {
              "migration": {"required": ["reason_code"]},
              "adapter": {"type": "null"}, "setup": {"type": "null"}, "stimulus": {"type": "null"},
              "determinism": {"type": "null"}, "observation": {"type": "null"}, "oracle": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["registry_entry_id", "ecosystem", "package", "version", "artifact_sha256", "dependency_locks", "source_review", "cases"],
      "properties": {
        "registry_entry_id": {"type": "string", "minLength": 1},
        "ecosystem": {"enum": ["nonebot", "koishi"]},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_locks": {
          "type": "object",
          "required": ["linux-x86_64", "windows-x86_64"],
          "properties": {"linux-x86_64": {"$ref": "#/$defs/profile"}, "windows-x86_64": {"$ref": "#/$defs/profile"}},
          "additionalProperties": false
        },
        "source_review": {"type": "object"},
        "cases": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/case"}}
      },
      "additionalProperties": false
    },
    "capabilityProbe": {
      "type": "object",
      "required": ["capability", "status", "required_hosts", "probe_id", "probe_spec"],
      "properties": {
        "capability": {"enum": ["service", "storage", "clock"]},
        "status": {"const": "required"},
        "required_hosts": {"const": ["native", "federated"]},
        "probe_id": {"type": "string", "minLength": 1},
        "probe_spec": {
          "type": "object",
          "required": ["version", "method", "assertion"],
          "properties": {
            "version": {"const": 1},
            "method": {"type": "string", "minLength": 1},
            "assertion": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
