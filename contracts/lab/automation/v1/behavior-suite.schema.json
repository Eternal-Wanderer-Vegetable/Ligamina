{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liganima.invalid/contracts/lab/automation/v1/behavior-suite.schema.json",
  "title": "Phase three entry-bound behavior fixture suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "catalog_snapshot_id", "entries", "legacy_regressions"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "catalog_snapshot_id": {"type": "string", "minLength": 1},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/entry"}
    },
    "legacy_regressions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/legacy"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object",
      "required": ["status", "profile_id", "dependency_lock_sha256", "artifact_sha256"],
      "properties": {
        "status": {"enum": ["eligible_not_run", "static_skipped"]},
        "profile_id": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "reason_code": {"type": "string"}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["path", "operator"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "not_equals", "contains", "not_contains", "length_equals", "in_range", "unchanged"]},
        "value": {},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "class", "stimuli", "assertions", "oracle"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["positive", "negative", "isolation"]},
        "stimuli": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "oracle": {
          "type": "object",
          "required": ["member", "symbol", "rationale", "review_status"],
          "properties": {
            "member": {"type": "string", "minLength": 1},
            "symbol": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 12},
            "review_status": {"const": "reviewed"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["registry_entry_id", "ecosystem", "package", "version", "artifact_sha256", "dependency_locks", "platforms", "source_review", "cases"],
      "properties": {
        "registry_entry_id": {"type": "string", "minLength": 1},
        "ecosystem": {"enum": ["nonebot", "koishi"]},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_upstream_sha512": {"type": ["string", "null"]},
        "dependency_locks": {
          "type": "object",
          "required": ["linux-x86_64", "windows-x86_64"],
          "properties": {"linux-x86_64": {"$ref": "#/$defs/profile"}, "windows-x86_64": {"$ref": "#/$defs/profile"}},
          "additionalProperties": false
        },
        "platforms": {"type": "array", "items": {"enum": ["linux-x86_64", "windows-x86_64"]}, "minItems": 2, "uniqueItems": true},
        "source_review": {
          "type": "object",
          "required": ["archive_member", "archive_member_sha256", "symbols", "reviewed_artifact_sha256", "review_status", "external_services"],
          "properties": {
            "archive_member": {"type": "string", "minLength": 1},
            "archive_member_sha256": {"$ref": "#/$defs/sha256"},
            "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "reviewed_artifact_sha256": {"$ref": "#/$defs/sha256"},
            "review_status": {"const": "reviewed"},
            "external_services": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "cases": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/case"}}
      },
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "required": ["unit_key", "sample_id", "ecosystem", "package", "version", "artifact_hash", "fixture_path", "platforms", "status"],
      "properties": {
        "unit_key": {"type": "string"},
        "sample_id": {"type": "string"},
        "ecosystem": {"enum": ["nonebot", "koishi"]},
        "package": {"type": "string"},
        "version": {"type": "string"},
        "artifact_hash": {"type": "string"},
        "fixture_path": {"type": "string"},
        "platforms": {"type": "array", "items": {"type": "string"}},
        "status": {"const": "regression_separate_not_run"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
