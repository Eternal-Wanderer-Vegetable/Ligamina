{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligamina.local/contracts/lab/automation/p7-koishi-context-profiles/v1.schema.json",
  "title": "P7 Koishi Synthetic Test Context Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "profile_id", "execution_scope", "authority_scope", "source_report", "synthetic_actor_id", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "p7_koishi_synthetic_context_profiles"},
    "profile_id": {"const": "p7-koishi-source-bound-context-v1"},
    "execution_scope": {"const": "linux_worker_only_network_disabled"},
    "authority_scope": {"const": "synthetic_test_actor_only"},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "outputs/acceptance/p7-p704-context-profile-source-audit-20261111.json"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "synthetic_actor_id": {"type": "string", "pattern": "^p7-offline-[A-Za-z0-9-]{1,48}$"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "lines"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "lines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_entry_id", "package", "version", "artifact_sha256", "command_ids", "plugin_config", "source_evidence"],
      "properties": {
        "registry_entry_id": {"type": "string", "pattern": "^ko-[0-9a-f]{24}$"},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/hash"},
        "command_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "plugin_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adminId"],
          "properties": {
            "adminId": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceEvidence"}}
      }
    }
  }
}
