{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligamina.dev/contracts/v0.1/platform-operation.schema.json",
  "title": "Ligamina PlatformOperation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "trace_id", "account_id", "operation", "target", "params"],
  "properties": {
    "operation_id": { "$ref": "#/$defs/id" },
    "trace_id": { "$ref": "#/$defs/id" },
    "account_id": { "$ref": "#/$defs/id" },
    "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["group", "private"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "params": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
